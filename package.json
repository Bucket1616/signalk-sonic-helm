  "license": "MIT",
  "version": "0.1.0",
  "description": "Synthesizes SignalK telemetry into dynamic audio frequencies and intervals.",
  "main": "index.js",
  "scripts": {
    "build:web": "esbuild public/app-src.js --bundle --outfile=public/app.js --format=iife",
    "test": "node --test test/**/*.test.js",
    "prebuild:web": "node -e \"require('./lib')\""
