// --- Global Variables ---
let audioCtx;
let oscillator;
let gainNode;
let isAudioEnabled = false;
let ws;

// Audio State
let currentFreq = 440;
let currentPeriod = 1000; // ms
let nextNoteTime = 0;
let timerID;

// Stop-sound gates (Out Of Bounds Behaviour)
let freqOutOfBoundsStop = false;
let periodOutOfBoundsStop = false;

// Config & Data State
let configs = [];
let activeConfig = null;

// Histories store values ALREADY CONVERTED into the user's preferred unit
// Each entry: { t: number (ms epoch), v: number }
let freqHistory = [];
let periodHistory = [];
let historyDurationMs = 10 * 60 * 1000; // default 10 minutes

// DOM Elements
const startMonitoringBtn = document.getElementById('startMonitoringBtn');
const stopMonitoringBtn = document.getElementById('stopMonitoringBtn');
const enableAudioBtn = document.getElementById('enableAudioBtn');
const stopAudioBtn = document.getElementById('stopAudioBtn');
const statusText = document.getElementById('status');
const configSelector = document.getElementById('configSelector');
const historySelect = document.getElementById('historySelect');

const freqCanvas = document.getElementById('freqHistogramCanvas');
const periodCanvas = document.getElementById('periodHistogramCanvas');
const freqCtx = freqCanvas.getContext('2d');
const periodCtx = periodCanvas.getContext('2d');

const displayFreqPath = document.getElementById('display-freq-path');
const displayFreqVal = document.getElementById('display-freq-val');
const displayPeriodPath = document.getElementById('display-period-path');
const displayPeriodVal = document.getElementById('display-period-val');


// =============================================================================
// Unit conversion (SignalK wire = SI  user preferred unit)
// =============================================================================
function normalizeUnit(u) {
    if (u == null) return '';
    let s = String(u).trim().toLowerCase();

    // common aliases
    s = s.replace('°', '');
    s = s.replace('degrees', 'deg').replace('degree', 'deg');
    s = s.replace('celsius', 'c').replace('fahrenheit', 'f');
    s = s.replace('kelvin', 'k');
    s = s.replace('meters/sec', 'm/s').replace('meter/sec', 'm/s').replace('mps', 'm/s');
    s = s.replace('meter', 'm').replace('metres', 'm').replace('metre', 'm');
    s = s.replace('foot', 'ft').replace('feet', 'ft');
    s = s.replace('nautical miles', 'nm').replace('nautical mile', 'nm');
    s = s.replace('knot', 'kn').replace('knots', 'kn');
    s = s.replace('mile/h', 'mph').replace('miles/h', 'mph').replace('miles per hour', 'mph');

    if (s === 'ms' || s === 'm/s') return 'm/s';
    if (s === 'kn' || s === 'kt' || s === 'kts') return 'knots';
    if (s === 'mph') return 'mph';
    if (s === 'm') return 'm';
    if (s === 'ft') return 'feet';
    if (s === 'nm') return 'NM';
    if (s === 'c') return '°C';
    if (s === 'f') return '°F';
    if (s === 'k') return 'K';
    if (s === 'deg' || s === 'rad' || s === 'radian' || s === 'radians') {
        return s.startsWith('rad') ? 'rad' : 'deg';
    }
    return String(u).trim(); // preserve original if already canonical like °C
}

function getMappingUnit(mapping) {
    if (!mapping) return '';
    return normalizeUnit(
        mapping.unit || mapping.units || mapping.dataUnit || mapping.dataUnits || ''
    );
}

function quantityFromPreferredUnit(prefUnit) {
    const u = normalizeUnit(prefUnit);
    if (u === 'm/s' || u === 'knots' || u === 'mph') return 'speed';
    if (u === 'm' || u === 'feet' || u === 'NM') return 'length';
    if (u === 'K' || u === '°C' || u === '°F') return 'temperature';
    if (u === 'rad' || u === 'deg') return 'angle';
    return 'raw';
}

// Path fallback when unit is missing/unknown
function quantityFromPath(path) {
    const p = String(path || '').toLowerCase();
    if (!p) return 'raw';

    if (
        p.includes('speed') ||
        p.includes('wind.speed') ||
        p.includes('sow') ||
        p.includes('sog') ||
        p.includes('stw') ||
        p.includes('velocity')
    ) return 'speed';

    if (
        p.includes('heading') ||
        p.includes('course') ||
        p.includes('bearing') ||
        p.includes('angle') ||
        p.includes('direction') ||
        p.includes('latitude') === false && p.includes('wind.angle')
    ) return 'angle';

    if (p.includes('wind.angle') || p.includes('rudder') || p.includes('awa') || p.includes('twa')) {
        return 'angle';
    }

    if (p.includes('depth') || p.includes('altitude') || p.includes('height') || p.includes('length') || p.includes('distance')) {
        return 'length';
    }

    if (p.includes('temperature') || p.includes('temp')) return 'temperature';

    return 'raw';
}

function siUnitForQuantity(q) {
    switch (q) {
        case 'speed': return 'm/s';
        case 'length': return 'm';
        case 'temperature': return 'K';
        case 'angle': return 'rad';
        default: return null;
    }
}

/**
 * Convert a SignalK SI value into the mapping's preferred unit.
 * Returns { value, unit, quantity }
 */
function convertSiToPreferred(siValue, mapping, pathForFallback) {
    const rawNum = Number(siValue);
    if (!Number.isFinite(rawNum)) {
        return { value: NaN, unit: '', quantity: 'raw' };
    }

    let pref = getMappingUnit(mapping);
    let quantity = quantityFromPreferredUnit(pref);

    // If no useful unit configured, infer quantity from path and choose a default preferred unit
    if (quantity === 'raw') {
        quantity = quantityFromPath(pathForFallback || (mapping && mapping.path));
        if (quantity === 'speed') pref = 'knots';
        else if (quantity === 'angle') pref = 'deg';
        else if (quantity === 'length') pref = 'm';
        else if (quantity === 'temperature') pref = '°C';
        else pref = '';
    }

    const si = siUnitForQuantity(quantity);
    if (!si || !pref) {
        // unknown: pass-through
        return { value: rawNum, unit: pref || '', quantity };
    }

    let v = rawNum; // currently in SI

    // speed: m/s  ...
    if (quantity === 'speed') {
        if (pref === 'm/s') v = rawNum;
        else if (pref === 'knots') v = rawNum * 1.9438444924406;
        else if (pref === 'mph') v = rawNum * 2.2369362920544;
    }

    // length: m  ...
    else if (quantity === 'length') {
        if (pref === 'm') v = rawNum;
        else if (pref === 'feet') v = rawNum * 3.2808398950131;
        else if (pref === 'NM') v = rawNum / 1852;
    }

    // temperature: K  ...
    else if (quantity === 'temperature') {
        if (pref === 'K') v = rawNum;
        else if (pref === '°C') v = rawNum - 273.15;
        else if (pref === '°F') v = (rawNum - 273.15) * 9 / 5 + 32;
    }

    // angle: rad  ...
    else if (quantity === 'angle') {
        if (pref === 'rad') v = rawNum;
        else if (pref === 'deg') v = rawNum * 180 / Math.PI;
    }

    return { value: v, unit: pref, quantity };
}

function isDegreesUnit(unit) {
    const u = normalizeUnit(unit);
    return u === 'deg';
}


// =============================================================================
// Transformation / OOB helpers (operate in PREFERRED units)
// =============================================================================
function normalizeTransformation(t) {
    if (t == null || t === '') return 'none';
    const s = String(t).toLowerCase().replace(/[_\s-]/g, '');
    if (s.includes('abs')) return 'absolute';
    if (s.includes('wrap')) return 'wrap360';
    if (s === 'none' || s === 'null' || s === 'identity') return 'none';
    return 'none';
}

function applyTransformation(preferredUnitValue, transformation) {
    let val = Number(preferredUnitValue);
    if (!Number.isFinite(val)) return NaN;

    const t = normalizeTransformation(transformation);
    if (t === 'absolute') return Math.abs(val);
    if (t === 'wrap360') {
        // Intended for angle-like data in degrees
        val = val % 360;
        if (val < 0) val += 360;
        return val;
    }
    return val; // none
}

function normalizeOobBehavior(mapping) {
    if (!mapping) return '';
    const raw =
        mappingoutOfBoundsBehavior || '';
    return String(raw).toLowerCase().trim();
}

function isStopOobBehavior(mapping) {
    const b = normalizeOobBehavior(mapping);
    return b.includes('stop');
}

function formatValueWithUnit(value, unit) {
    const num = (typeof value === 'number') ? value : Number(value);
    const text = Number.isFinite(num) ? (Math.round(num * 1000) / 1000).toString() : String(value);
    return unit ? `${text} ${unit}` : text;
}


// --- 1. Initialization (Fetch Configs on Load) ---
fetch('/plugins/signalk-sonic-helm/settings')
    .then(res => res.json())
    .then(data => {
        configs = (data.configuration && data.configuration.audioModes) || data.audioModes || [];
        configSelector.innerHTML = '';

        configs.forEach((config, index) => {
            const option = document.createElement('option');
            option.value = index;
            option.textContent = config.modeName || config.name || `Configuration ${index + 1}`;
            configSelector.appendChild(option);
        });

        configSelector.disabled = false;
        if (configs.length > 0) {
            activeConfig = configs[0];
            console.log('Loaded configs:', configs);
            updateMonitoringUI();
            drawAllHistograms();
        }
    })
    .catch(e => {
        console.warn('Could not load config, using defaults.', e);
        configSelector.innerHTML = '<option>Error loading configs</option>';
    });

// Seamless config switching
configSelector.addEventListener('change', (e) => {
    activeConfig = configs[e.target.value];

    freqHistory = [];
    periodHistory = [];
    freqOutOfBoundsStop = false;
    periodOutOfBoundsStop = false;

    updateMonitoringUI();
    drawAllHistograms();

    if (ws && ws.readyState === WebSocket.OPEN) {
        statusText.innerText = 'Status: Connected & Subscribed. (Config switched)';
    }
});

historySelect.addEventListener('change', (e) => {
    const minutes = parseInt(e.target.value, 10);
    historyDurationMs = minutes * 60 * 1000;
    trimHistories();
    drawAllHistograms();
});


// --- 2. Button Controls ---
startMonitoringBtn.addEventListener('click', () => {
    statusText.innerText = 'Status: Connecting...';
    connectSignalK();

    startMonitoringBtn.style.display = 'none';
    stopMonitoringBtn.style.display = 'inline-block';
    enableAudioBtn.style.display = 'inline-block';
    stopAudioBtn.style.display = 'none';

    statusText.innerText = 'Status: Connected. Waiting for Audio Enable.';
});

stopMonitoringBtn.addEventListener('click', () => {
    if (ws) ws.close();
    if (stopAudioBtn.style.display !== 'none') {
        stopAudioBtn.click();
    }
    enableAudioBtn.style.display = 'none';
    startMonitoringBtn.style.display = 'inline-block';
    stopMonitoringBtn.style.display = 'none';
});

enableAudioBtn.addEventListener('click', async () => {
    if (!audioCtx) {
        audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        oscillator = audioCtx.createOscillator();
        gainNode = audioCtx.createGain();

        oscillator.type = 'sine';
        gainNode.gain.value = 0;

        oscillator.connect(gainNode);
        gainNode.connect(audioCtx.destination);
        oscillator.start();

        isAudioEnabled = true;
        nextNoteTime = audioCtx.currentTime + 0.1;
        scheduleAudio();
    }

    if (audioCtx.state === 'suspended') {
        await audioCtx.resume();
    }

    try {
        if ('wakeLock' in navigator) {
            await navigator.wakeLock.request('screen');
            console.log('Wake Lock is active');
        }
    } catch (err) {
        console.error(`Wake Lock error: ${err.name}, ${err.message}`);
    }

    enableAudioBtn.style.display = 'none';
    stopAudioBtn.style.display = 'inline-block';
    statusText.innerText = 'Status: Active & Playing';
});

stopAudioBtn.addEventListener('click', () => {
    if (audioCtx) {
        audioCtx.suspend();
    }
    stopAudioBtn.style.display = 'none';
    enableAudioBtn.style.display = 'inline-block';
    statusText.innerText = 'Status: Audio Paused';
});


// --- 3. WebSocket Connection to SignalK ---
function getAllConfigPaths() {
    const pathSet = new Set();
    configs.forEach((cfg) => {
        if (cfg.frequencyMapping && cfg.frequencyMapping.path) pathSet.add(cfg.frequencyMapping.path);
        if (cfg.periodMapping && cfg.periodMapping.path) pathSet.add(cfg.periodMapping.path);
    });
    return Array.from(pathSet);
}

function connectSignalK() {
    const wsProtocol = window.location.protocol === 'https:' ? 'wss:' : 'ws:';
    const wsUrl = `${wsProtocol}//${window.location.host}/signalk/v1/stream?subscribe=none`;
    ws = new WebSocket(wsUrl);

    ws.onopen = () => {
        const paths = getAllConfigPaths();
        const subRequest = {
            context: 'vessels.self',
            subscribe: paths.map((path) => ({
                path: path,
                period: 1000
            }))
        };
        ws.send(JSON.stringify(subRequest));
        statusText.innerText = 'Status: Connected & Subscribed (all config paths).';
    };

    ws.onmessage = (event) => {
        const msg = JSON.parse(event.data);

        if (msg.updates) {
            msg.updates.forEach(update => {
                const ts = update.timestamp ? Date.parse(update.timestamp) : Date.now();

                update.values.forEach(value => {
                    if (value.value === undefined || value.value === null) return;

                    const siRaw = Number(value.value);
                    if (!Number.isFinite(siRaw)) return;

                    if (!activeConfig) return;

                    const freqPath = activeConfig.frequencyMapping ? activeConfig.frequencyMapping.path : null;
                    const periodPath = activeConfig.periodMapping ? activeConfig.periodMapping.path : null;

                    // ---- Frequency path ----
                    if (value.path === freqPath && activeConfig.frequencyMapping) {
                        const conv = convertSiToPreferred(siRaw, activeConfig.frequencyMapping, value.path);
                        const preferredVal = conv.value;

                        // Audio / OOB / transform in preferred units
                        const result = calculateMapping(preferredVal, activeConfig.frequencyMapping, 'hz');
                        freqOutOfBoundsStop = result.stop;
                        currentFreq = result.value;

                        // Display + history in preferred units (pre-transform)
                        displayFreqVal.textContent = formatValueWithUnit(preferredVal, conv.unit);
                        pushHistory(freqHistory, ts, preferredVal);
                        drawHistogram(
                            freqCtx,
                            freqCanvas,
                            freqHistory,
                            activeConfig.modeName ? `${activeConfig.modeName} — Frequency` : 'Frequency',
                            `${freqPath}${conv.unit ? ' (' + conv.unit + ')' : ''}`,
                            activeConfig.frequencyMapping
                        );
                    }

                    // ---- Period path ----
                    if (value.path === periodPath && activeConfig.periodMapping) {
                        const conv = convertSiToPreferred(siRaw, activeConfig.periodMapping, value.path);
                        const preferredVal = conv.value;

                        const result = calculateMapping(preferredVal, activeConfig.periodMapping, 'period');
                        periodOutOfBoundsStop = result.stop;
                        currentPeriod = result.value;

                        displayPeriodVal.textContent = formatValueWithUnit(preferredVal, conv.unit);
                        pushHistory(periodHistory, ts, preferredVal);
                        drawHistogram(
                            periodCtx,
                            periodCanvas,
                            periodHistory,
                            activeConfig.modeName ? `${activeConfig.modeName} — Period` : 'Period',
                            `${periodPath}${conv.unit ? ' (' + conv.unit + ')' : ''}`,
                            activeConfig.periodMapping
                        );
                    }

                    // If a non-active config path arrives, still keep audio quiet logic only for active paths.
                    // (We subscribe to all paths for fast config switching; only activeConfig drives audio/UI.)
                    if (value.path !== freqPath && value.path !== periodPath) {
                        // no-op for UI/audio; reserved for future multi-mode history if desired
                    }
                });
            });
        }
    };

    ws.onclose = () => {
        statusText.innerText = 'Status: Connection Closed.';
    };
}


// --- 4. Data Processing (preferred-unit value in, transform + OOB for audio) ---
/**
 * preferredValue: already converted from SI  user unit
 * Returns { value, stop }
 */
function calculateMapping(preferredValue, config, type) {
    const fallback = type === 'hz' ? 0 : 1000;
    if (!config) return { value: fallback, stop: false };

    // 1) transform in preferred units (audio only; charts store pre-transform)
    let val = applyTransformation(preferredValue, config.transformation);
    if (!Number.isFinite(val)) return { value: fallback, stop: true };

    const min = Number(config.dataMin);
    const max = Number(config.dataMax);
    const hasRange = Number.isFinite(min) && Number.isFinite(max);

    // 2) out-of-bounds in preferred units
    if (hasRange && (val < min || val > max)) {
        if (isStopOobBehavior(config)) {
            return { value: fallback, stop: true };
        }
        val = Math.max(min, Math.min(max, val));
    }

    // 3) linear map to hz or ms
    const dataMin = hasRange ? min : 0;
    const dataMax = hasRange ? max : 1;
    const dataRange = dataMax - dataMin;

    const outMin = type === 'hz' ? Number(config.hzMin) : Number(config.msMin);
    const outMax = type === 'hz' ? Number(config.hzMax) : Number(config.msMax);
    const safeOutMin = Number.isFinite(outMin) ? outMin : (type === 'hz' ? 440 : 1000);
    const safeOutMax = Number.isFinite(outMax) ? outMax : (type === 'hz' ? 880 : 2000);

    if (dataRange === 0) return { value: safeOutMin, stop: false };

    const mapped = safeOutMin + ((val - dataMin) / dataRange) * (safeOutMax - safeOutMin);
    return { value: mapped, stop: false };
}


// --- 5. Audio Scheduling Loop ---
function audioShouldBeSilent() {
    return !isAudioEnabled || freqOutOfBoundsStop || periodOutOfBoundsStop || currentFreq <= 0;
}

function scheduleAudio() {
    if (!isAudioEnabled || !audioCtx) return;

    while (nextNoteTime < audioCtx.currentTime + 0.1) {
        playPulse(nextNoteTime);
        const periodSec = Math.max(0.05, (currentPeriod || 1000) / 1000.0);
        nextNoteTime += periodSec;
    }

    timerID = requestAnimationFrame(scheduleAudio);
}

function playPulse(time) {
    if (!oscillator || !gainNode) return;

    // Hard mute when OOB Stop Sound is active
    if (audioShouldBeSilent()) {
        gainNode.gain.cancelScheduledValues(time);
        gainNode.gain.setValueAtTime(0, time);
        return;
    }

    const duration = Math.max(0.05, ((currentPeriod || 1000) / 1000.0) / 2);

    oscillator.frequency.setValueAtTime(Math.max(0, currentFreq), time);

    gainNode.gain.cancelScheduledValues(time);
    gainNode.gain.setValueAtTime(0, time);
    gainNode.gain.linearRampToValueAtTime(0.5, time + 0.05);
    gainNode.gain.setValueAtTime(0.5, Math.max(time + 0.05, time + duration - 0.05));
    gainNode.gain.linearRampToValueAtTime(0, time + duration);
}


// --- 6. Histogram Visualization ---
function pushHistory(historyArr, t, v) {
    if (!Number.isFinite(v)) return;
    historyArr.push({ t, v });
    trimHistoryArray(historyArr);
}

function trimHistoryArray(historyArr) {
    const cutoff = Date.now() - historyDurationMs;
    while (historyArr.length && historyArr[0].t < cutoff) historyArr.shift();
}

function trimHistories() {
    trimHistoryArray(freqHistory);
    trimHistoryArray(periodHistory);
}

function computeYAxisRange(mapping, historyArr) {
    const t = normalizeTransformation(mapping && mapping.transformation);
    const unit = getMappingUnit(mapping);
    const degrees = isDegreesUnit(unit) || quantityFromPreferredUnit(unit) === 'angle';

    let yMin;
    let yMax;

    if (t === 'wrap360') {
        yMin = 0;
        yMax = 360;
    } else if (t === 'absolute') {
        // charts use pre-transform preferred-unit values
        yMin = degrees ? -180 : 0;
        yMax = 180;
    } else {
        // None
        yMin = 0;
        yMax = (mapping && typeof mapping.dataMax === 'number') ? mapping.dataMax : 1;
    }

    // Expand max upward to ceil(max stored preferred value)
    let maxStored = -Infinity;
    let minStored = Infinity;
    for (let i = 0; i < historyArr.length; i++) {
        const v = historyArr[i].v;
        if (!Number.isFinite(v)) continue;
        if (v > maxStored) maxStored = v;
        if (v < minStored) minStored = v;
    }

    if (Number.isFinite(maxStored)) {
        const roundedUp = Math.ceil(maxStored);
        if (roundedUp > yMax) yMax = roundedUp;
    }

    // For absolute + angle/degrees, allow min to floor lower if needed
    if (t === 'absolute' && degrees && Number.isFinite(minStored) && minStored < yMin) {
        yMin = Math.floor(minStored);
    }

    // Also, if transformation is none and values go negative (e.g. unusual sensor), expose them
    if (t === 'none' && Number.isFinite(minStored) && minStored < yMin) {
        // keep 0 baseline unless data truly negative and not angle-wrap/abs mode
        // For speed/temp this usually won't trigger.
        if (minStored < 0) yMin = Math.floor(minStored);
    }

    if (!(yMax > yMin)) yMax = yMin + 1;
    return { yMin, yMax };
}

function drawAllHistograms() {
    if (!activeConfig) {
        drawHistogram(freqCtx, freqCanvas, freqHistory, 'Frequency', 'Value', null);
        drawHistogram(periodCtx, periodCanvas, periodHistory, 'Period', 'Value', null);
        return;
    }

    const freqPath = activeConfig.frequencyMapping ? activeConfig.frequencyMapping.path : 'Frequency Value';
    const periodPath = activeConfig.periodMapping ? activeConfig.periodMapping.path : 'Period Value';
    const freqUnit = getMappingUnit(activeConfig.frequencyMapping);
    const periodUnit = getMappingUnit(activeConfig.periodMapping);

    drawHistogram(
        freqCtx,
        freqCanvas,
        freqHistory,
        activeConfig.modeName ? `${activeConfig.modeName} — Frequency` : 'Frequency',
        `${freqPath}${freqUnit ? ' (' + freqUnit + ')' : ''}`,
        activeConfig.frequencyMapping
    );

    drawHistogram(
        periodCtx,
        periodCanvas,
        periodHistory,
        activeConfig.modeName ? `${activeConfig.modeName} — Period` : 'Period',
        `${periodPath}${periodUnit ? ' (' + periodUnit + ')' : ''}`,
        activeConfig.periodMapping
    );
}

function drawHistogram(ctx, canvas, historyArr, title, yLabel, mapping) {
    if (!ctx) return;

    const W = canvas.width;
    const H = canvas.height;
    const padL = 54;
    const padR = 16;
    const padT = 36;
    const padB = 42;
    const plotW = W - padL - padR;
    const plotH = H - padT - padB;

    ctx.clearRect(0, 0, W, H);

    ctx.fillStyle = '#ffffff';
    ctx.fillRect(0, 0, W, H);

    // Title
    ctx.fillStyle = '#111';
    ctx.font = 'bold 14px Arial';
    ctx.textAlign = 'center';
    ctx.textBaseline = 'top';
    ctx.fillText(title || 'Histogram', W / 2, 8);

    // Y label
    ctx.save();
    ctx.translate(14, padT + plotH / 2);
    ctx.rotate(-Math.PI / 2);
    ctx.font = '12px Arial';
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    ctx.fillStyle = '#333';
    ctx.fillText(yLabel || 'Value', 0, 0);
    ctx.restore();

    // X label
    const histText = historySelect && historySelect.selectedOptions[0]
        ? historySelect.selectedOptions[0].text
        : 'History';
    ctx.font = '12px Arial';
    ctx.textAlign = 'center';
    ctx.textBaseline = 'bottom';
    ctx.fillStyle = '#333';
    ct.fillText(`Time (${histText})`, padL + plotW / 2, H - 4);

    // Frame
    ctx.strokeStyle = '#ccc';
    ctx.lineWidth = 1;
    ctx.strokeRect(padL, padT, plotW, plotH);

    if (!historyArr.length) {
        ctx.fillStyle = '#888';
        ctx.font = '12px Arial';
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.fillText('Waiting for data…', padL + plotW / 2, padT + plotH / 2);
        return;
    }

    const tEnd = Date.now();
    const tStart = tEnd - historyDurationMs;

    const { yMin, yMax } = computeYAxisRange(mapping, historyArr);
    const yRange = (yMax - yMin) || 1;

    function xForTime(t) {
        return padL + ((t - tStart) / historyDurationMs) * plotW;
    }
    function yForValue(v) {
        return padT + plotH - ((v - yMin) / yRange) * plotH;
    }

    // Grid + Y ticks
    ctx.strokeStyle = '#eee';
    ctx.fillStyle = '#555';
    ctx.font = '10px Arial';
    ctx.textAlign = 'right';
    ctx.textBaseline = 'middle';
    const yTicks = 4;
    for (let i = 0; i <= yTicks; i++) {
        const v = yMin + (yRange * i / yTicks);
        const y = yForValue(v);
        ctx.beginPath();
        ctx.moveTo(padL, y);
        ctx.lineTo(padL + plotW, y);
        ctx.stroke();
        ctx.fillText((Math.round(v * 100) / 100).toString(), padL - 6, y);
    }

    // Zero crossing line
    if (yMin < 0 && yMax > 0) {
        const y0 = yForValue(0);
        ctx.strokeStyle = '#888';
        ctx.lineWidth = 1.5;
        ctx.beginPath();
        ctx.moveTo(padL, y0);
        ctx.lineTo(padL + plotW, y0);
        ctx.stroke();
        ctx.lineWidth = 1;
    }

    // X ticks
    ctx.textAlign = 'center';
    ctx.textBaseline = 'top';
    ctx.fillStyle = '#555';
    ctx.strokeStyle = '#eee';
    const xTicks = 4;
    for (let i = 0; i <= xTicks; i++) {
        const t = tStart + (historyDurationMs * i / xTicks);
        const x = xForTime(t);

        ctx.beginPath();
        ctx.moveTo(x, padT);
        ctx.lineTo(x, padT + plotH);
        ctx.stroke();

        const minutesAgo = Math.round((tEnd - t) / 60000);
        const label = (i === xTicks) ? 'now' : `-${minutesAgo}m`;
        ctx.fillText(label, x, padT + plotH + 6);
    }

    // Data line (preferred units, pre-transform)
    ctx.strokeStyle = '#00aa00';
    ctx.lineWidth = 2;
    ctx.beginPath();
    let started = false;
    for (let i = 0; i < historyArr.length; i++) {
        const pt = historyArr[i];
        if (pt.t < tStart || pt.t > tEnd) continue;
        const x = xForTime(pt.t);
        const y = yForValue(pt.v);
        if (!started) {
            ctx.moveTo(x, y);
            started = true;
        } else {
            ctx.lineTo(x, y);
        }
    }
    ctx.stroke();
}

function updateMonitoringUI() {
    if (activeConfig) {
        displayFreqPath.textContent = activeConfig.frequencyMapping ? activeConfig.frequencyMapping.path : 'Not set';
        displayPeriodPath.textContent = activeConfig.periodMapping ? activeConfig.periodMapping.path : 'Not set';
        displayFreqVal.textContent = '--';
        displayPeriodVal.textContent = '--';
    }
}
